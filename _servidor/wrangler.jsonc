{
  // Configuração do Cloudflare Workers para brunomichels.com.br
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drbruno-site",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // estas rotas passam primeiro pelo servidor (login e proteção do código)
    "run_worker_first": ["/api/*", "/calculadoras", "/calculadoras/*", "/pericias", "/pericias/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "drbruno",
      "database_id": "9ac81953-42d1-49b4-8dba-5a01c78e86b2"
    },
    {
      // banco separado do /pericias (usuários da equipe, sessões e registro)
      "binding": "DBP",
      "database_name": "drbruno_pericias",
      "database_id": "af000d02-6578-4f18-8d56-9f7f0e671ea4"
    },
    {
      // cofre: o segredo principal (gerado pelo próprio site) e a chave do Apps Script (pareamento)
      "binding": "COFRE",
      "database_name": "drbruno_cofre",
      "database_id": "838db246-576e-4f9c-b0b8-fa37c231286e"
    }
  ],
  // configurações que não são segredo (os segredos ficam no banco COFRE, criados pelo próprio site)
  "vars": {
    // endereço do Apps Script da planilha de perícias; sozinho não serve para nada sem a assinatura do site
    "PERICIAS_GAS_URL": "https://script.google.com/macros/s/AKfycbxdYxLIQNJuQEgIYvz3RdlwitgR_7aUYoywhYoB0abE4oigpZttzAEdwUeNfpWTmoc4/exec"
  },
  // limpeza diária de sessões vencidas (04:00 em Brasília)
  "triggers": { "crons": ["0 7 * * *"] },
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": false
}
